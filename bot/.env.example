# Names only: copy to .env (here or at the repo root) and fill in. Never commit .env.

# --- required
BOT_TOKEN=               # from @BotFather
BOT_USERNAME=            # without the @
MINIAPP_URL=             # public HTTPS URL of the Mini App
NETWORK=testnet          # testnet | mainnet | local

# --- optional
MINIAPP_SHORTNAME=       # BotFather Direct Link short name: claim/pay links open straight in the Mini App
PUBLIC_URL=              # this server's public URL (used for webhooks and self-links)
KEEPER_PRIVATE_KEY=      # funded testnet key: runs the keeper (protect()) and relays claim links
RELAYER_PRIVATE_KEY=     # defaults to KEEPER_PRIVATE_KEY
KEEPER_MIN_BTC=0.001     # admins are alerted when the keeper/relayer balance drops below this
ADMIN_IDS=               # comma-separated Telegram user ids that receive ops alerts
RPC_URL=                 # default https://rpc.test.mezo.org
PORT=8787
POLL_MS=30000
DB_PATH=.keel-data/keel.sqlite
TURSO_DATABASE_URL=      # optional: mirror the SQLite store to Turso so it survives redeploys
TURSO_AUTH_TOKEN=
CRON_SECRET=             # bearer secret for /ops/* tick endpoints (cron-job.org or similar)
KEEL_FACTORY=            # overrides shared/deployments/<network>.json
KEEL_PAY=
PREMIUM_PAY_TO=          # treasury address that receives x402 premium payments (enables /premium)
PREMIUM_PRICE_MUSD=1
PREMIUM_DAYS=30
X402_FACILITATOR_URL=https://facilitator.vativ.io
