# --- required
BOT_TOKEN=               # from @BotFather
BOT_USERNAME=            # without the @
MINIAPP_URL=             # public HTTPS URL that reaches this server (tunnel or host)
NETWORK=testnet          # testnet | mainnet | local

# --- optional
MINIAPP_SHORTNAME=       # BotFather Direct Link short name: makes claim links private to the Mini App
KEEPER_PRIVATE_KEY=      # funded testnet key: runs the keeper (protect()) and relays claim links
RELAYER_PRIVATE_KEY=     # defaults to KEEPER_PRIVATE_KEY
RPC_URL=                 # default https://rpc.test.mezo.org
PORT=8787
POLL_MS=30000
KEEL_FACTORY=            # overrides shared/deployments/<network>.json
KEEL_PAY=
PREMIUM_PAY_TO=          # treasury address that receives x402 premium payments (enables /premium)
PREMIUM_PRICE_MUSD=1
PREMIUM_DAYS=30
X402_FACILITATOR_URL=https://facilitator.vativ.io
