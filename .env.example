# Root .env: read by the bot (`pnpm --filter bot dev|start` loads ../.env, then bot/.env) and by the
# testnet scripts in bot/scripts. Names only: copy to .env and fill in. Never commit .env.
# The full list of bot settings, with defaults, is in bot/.env.example.

# --- bot (required)
BOT_TOKEN=                 # from @BotFather
BOT_USERNAME=              # without the @
MINIAPP_URL=               # public HTTPS URL of the Mini App
NETWORK=testnet            # testnet | mainnet | local

# --- bot (optional)
MINIAPP_SHORTNAME=         # BotFather Direct Link short name (e.g. app)
KEEPER_PRIVATE_KEY=        # funded testnet key: keeper + claim-link relayer
PREMIUM_PAY_TO=            # treasury address for x402 premium payments
TURSO_DATABASE_URL=        # optional durable mirror of the SQLite store
TURSO_AUTH_TOKEN=
CRON_SECRET=               # protects /ops/* tick endpoints called by a scheduler

# --- scripts and contract deploys only (not needed to run the bot)
DEPLOYER_PRIVATE_KEY=      # funded testnet key used by contracts deploy and bot/scripts/*-testnet.ts
WALLETCONNECT_PROJECT_ID=  # copied into miniapp VITE_WC_PROJECT_ID at build time
