{
  "name": "@keel/contracts",
  "version": "1.1.1",
  "license": "GPL-3.0",
  "private": "true",
  "scripts": {
    "build": "hardhat compile",
    "clean": "hardhat clean && rm -rf cache/ build/ typechain/",
    "coverage": "hardhat coverage",
    "deploy": "npm run prepare:env && hardhat deploy",
    "format": "npm run lint:ts && npm run lint:sol && npm run lint:config",
    "format:fix": "npm run lint:ts:fix && npm run lint:sol:fix && npm run lint:config:fix",
    "lint:config": "prettier --check '**/*.@(json|md)'",
    "lint:config:fix": "prettier --write '**/*.@(json|md)'",
    "lint:sol": "solhint 'contracts/**/*.sol' --max-warnings 0 && prettier --plugin=prettier-plugin-solidity --check 'contracts/**/*.sol'",
    "lint:sol:fix": "solhint 'contracts/**/*.sol' --fix && prettier --plugin=prettier-plugin-solidity --write 'contracts/**/*.sol'",
    "lint:ts": "eslint .",
    "lint:ts:fix": "eslint . --fix",
    "node": "hardhat node",
    "order-deploy": "node scripts/order-deploy-scripts.mjs",
    "prepare:env": "cp -n .env.example .env || true",
    "test": "npm run prepare:env && hardhat test",
    "test:upgrades": "npm run prepare:env && NODE_ENV=upgrades-test hardhat test ./test/upgrade/*.upgrades.test.ts --network mainnet_fork",
    "dev:chain": "KEEL_SOLCJS=${KEEL_SOLCJS:-0} hardhat run scripts/dev-chain.ts",
    "set-price": "ts-node --transpile-only scripts/set-price.ts",
    "deploy:keel:testnet": "hardhat run scripts/deploy-keel.ts --network matsnet",
    "deploy:keel:mainnet": "hardhat run scripts/deploy-keel.ts --network mainnet",
    "test:keel": "hardhat test test/keel/*.test.ts"
  },
  "devDependencies": {
    "@keep-network/hardhat-helpers": "^0.7.1",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.3",
    "@nomicfoundation/hardhat-ethers": "^3.0.5",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@openzeppelin/hardhat-upgrades": "^3.2.1",
    "@types/mocha": "^10.0.7",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "chai": "^4.3.4",
    "dotenv-safer": "^1.0.0",
    "eslint": "^8.56.0",
    "ethers": "^6.8.1",
    "hardhat": "^2.19.4",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-deploy": "^0.11.45",
    "hardhat-gas-reporter": "^1.0.10",
    "istanbul": "^0.4.5",
    "prettier": "^3.1.1",
    "prettier-plugin-solidity": "^1.3.1",
    "solc": "0.8.24",
    "solhint": "^4.0.0",
    "solhint-config-thesis": "^0.1.0",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.2.0",
    "@openzeppelin/contracts-upgradeable": "^5.2.0",
    "solidity-coverage": "^0.8.14"
  }
}